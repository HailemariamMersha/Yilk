# Yilk - Public Landing Page Only
# This .gitignore keeps only the landing page files public
# All business logic, backend code, and sensitive files are excluded

# =============================================================================
# KEEP PUBLIC (Landing Page Files)
# =============================================================================
# These files will be included in the public repository:
# - index.html
# - style.css  
# - typewriter.js
# - logo.png
# - README.md
# - CNAME
# - .gitignore

# =============================================================================
# EXCLUDE EVERYTHING ELSE
# =============================================================================

# Business Logic & Backend
/backend/
/server/
/api/
/src/
/components/
/utils/
/services/
/database/
/models/
/controllers/
/middleware/
/routes/

# Configuration Files
.env
.env.local
.env.development
.env.production
config/
secrets/
keys/
credentials/

# Business Documents
/docs/business/
/docs/strategy/
/docs/monetization/
/docs/user-research/
business-plan.*
strategy.*
monetization.*
user-research.*
competitive-analysis.*
market-research.*

# Development Files
node_modules/
package.json
package-lock.json
yarn.lock
.npm/
.yarn/

# Build Files
/build/
/dist/
/out/
.next/
.nuxt/
.cache/

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime
pids/
*.pid
*.seed
*.pid.lock

# Database Files
*.db
*.sqlite
*.sqlite3
/database.sql
/migrations/
/seeds/

# Analytics & Tracking
analytics/
tracking/
user-data/
metrics/

# AI/ML Models
/models/
*.pkl
*.joblib
*.h5
*.pb
training-data/
datasets/

# Financial Data
financial/
revenue/
costs/
pricing/

# Legal Documents
legal/
contracts/
agreements/
terms/
privacy/

# Internal Communications
internal/
team/
meetings/
notes/
brainstorming/

# Marketing Strategy (keep execution, hide strategy)
marketing-strategy/
campaign-data/
user-personas/
market-segments/

# Technical Architecture
architecture/
system-design/
infrastructure/
deployment/

# Testing (if contains business logic)
/tests/
/test/
*.test.js
*.spec.js

# Temporary Files
tmp/
temp/
.tmp/

# OS Generated Files
.DS_Store?
ehthumbs.db
Icon?

# Coverage Reports
coverage/
.nyc_output/

# Dependency Directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Environment variables
.env.test

# Next.js
.next

# Nuxt.js
.nuxt

# Gatsby files
.cache/
public

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/
